# Demo mode: sign in with demo accounts without real Sony/Microsoft credentials.
# Default: true in development, false in production.
DEMO_MODE=true

# Public URL of the app (used for OAuth redirects and Secure cookies).
APP_URL=http://localhost:3000

# SQLite file path.
DATABASE_PATH=./data/trophy-sync.db

# Secret for encrypted session cookies (at least 32 random characters!).
# Generate: openssl rand -base64 48
SESSION_SECRET=replace-me-with-a-long-random-value

# Key for encrypting PSN/Xbox tokens at rest (defaults to SESSION_SECRET).
TOKEN_ENCRYPTION_KEY=

# Admin password for /admin (at least 12 characters in production).
ADMIN_PASSWORD=admin

# Xbox Live: Microsoft Entra app registration (free) – see README.
# Redirect URI in Entra: ${APP_URL}/api/auth/xbox/callback
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=

# Trophy suggestions at or above this similarity (0..1) are accepted automatically.
AUTO_MAP_THRESHOLD=0.92
