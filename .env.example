# Demo-Modus: Login mit Demo-Konten ohne echte Zugangsdaten (Standard: true)
DEMO_MODE=true

# Öffentliche URL der App (für OAuth-Redirects)
APP_URL=http://localhost:3000

# Pfad der SQLite-Datenbank
DATABASE_PATH=./data/trophy-sync.db

# Geheimnis für Session-Cookies (mindestens 32 Zeichen!)
SESSION_SECRET=bitte-durch-einen-langen-zufaelligen-wert-ersetzen

# Passwort für den Admin-Bereich
ADMIN_PASSWORD=admin

# Xbox Live: Azure App Registration (https://portal.azure.com → App-Registrierungen)
# Redirect-URI in Azure: ${APP_URL}/api/auth/xbox/callback
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=

# Ab dieser Ähnlichkeit (0..1) werden Trophäen-Vorschläge automatisch übernommen
AUTO_MAP_THRESHOLD=0.92
